# Copy to .env and fill in. .env is git-ignored: never commit it.

# ---- Team (required) ---------------------------------------------------
# Time zone for "yesterday" in nightly summaries and for cron schedules.
TEAM_TIMEZONE=UTC

# ---- LLM (required) ----------------------------------------------------
# Any OpenAI-compatible endpoint whose model supports tool calling. Examples:
#   OpenAI       https://api.openai.com/v1
#   OpenRouter   https://openrouter.ai/api/v1
# Reasoning effort is set in hermes/config.yaml (agent.reasoning_effort).
LLM_API_KEY=
LLM_BASE_URL=
AGENT_MODEL=

# ---- Jev routing (optional) --------------------------------------------
# TypeSafe Jev (console.typesafe.ai) picks the model per message (oa_router) and hints skills
# (jev-skill-router). Empty = both off; every message runs on AGENT_MODEL.
# With a key, fill in the model ladder under oa_router in hermes/config.yaml first.
TYPESAFE_API_KEY=

# ---- Database (required; generate each with: openssl rand -hex 24) ----
POSTGRES_PASSWORD=
COLLECTOR_DB_PASSWORD=
HERMES_DB_PASSWORD=

# ---- Slack (required, Socket Mode; see README "Slack app") ------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Member IDs allowed to use the bot, comma-separated. Empty = nobody.
SLACK_ALLOWED_USERS=
# true = anyone in the workspace can use the bot (overrides SLACK_ALLOWED_USERS).
SLACK_ALLOW_ALL_USERS=false
SLACK_ALLOWED_CHANNELS=
SLACK_HOME_CHANNEL=

# ---- Telegram (optional, read by the collector only) ------------------
# api_id / api_hash from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Make one with: docker compose run --rm collector python -m collector.login
# It is a full login to that Telegram account: treat it like a password.
TELEGRAM_SESSION_STRING=
# Chat ids to collect, comma-separated (collector.login --list shows them).
TELEGRAM_GROUPS=
BACKFILL_LIMIT=2000

# ---- Jira (optional) ---------------------------------------------------
# Token: id.atlassian.com/manage-profile/security/api-tokens. The agent acts as this account.
JIRA_BASE_URL=https://YOUR-SITE.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=

# ---- GitHub (optional; also set enabled: true under mcp_servers.github) -
# OAuth App token from a device login (README "GitHub"). The client id is only for getting the token.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_TOKEN=

# ---- Hermes web dashboard (optional). No username = dashboard stays off.
HERMES_DASHBOARD_PUBLIC_URL=
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# openssl rand -hex 32 (keeps logins valid across restarts)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
